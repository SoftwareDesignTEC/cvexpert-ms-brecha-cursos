
PORT=3000
NODE_ENV=development

# Solo local development/test, nunca Azure. Sin esta opción se exige certificado.
APIM_ALLOW_INSECURE_LOCAL=true
# SHA-1 hexadecimal de 40 caracteres, sin separadores; rotación: huella1,huella2.
# En Azure/producción completar y quitar el bypass local.
APIM_CERT_THUMBPRINTS=

# Node se conecta al puerto publicado en el host, no al puerto interno.
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=cvexpert_catalog
PGUSER=cvexpert_local
# Completar SOLO en .env con una contraseña local; nunca versionarla.
PGPASSWORD=

# disable solo para el PostgreSQL local. Fuera de development/test se exige verify-full.
DB_SSL_MODE=disable
# Opcional: ruta a una CA PEM confiable; vacío usa las CA de Node.
PGSSLROOTCERT=

# Contexto revisado del servidor para el flujo HTTP (sin default inventado).
# Dejar vacío conserva GET /skills-gap no disponible; PUT no necesita mercado.
SKILLS_GAP_MARKET_KEY=
