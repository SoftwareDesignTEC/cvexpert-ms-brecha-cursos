{
  "name": "cvexpert-ms-brecha-cursos",
  "version": "1.0.1",
  "description": "Microservicio de brecha de habilidades y recomendación de cursos de CVExpert",
  "main": "index.js",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:check": "tsx src/db/cli.ts check",
    "db:test": "node --import tsx --test test/db/*.test.ts",
    "db:market:import": "tsx scripts/import-market.ts",
    "db:catalog:import": "tsx scripts/import-catalog.ts",
    "db:admin:preview": "tsx scripts/admin-import.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc -p tsconfig.maintenance.json",
    "start": "node dist/server.js",
    "db:admin:plan": "tsx scripts/admin-apply.ts plan",
    "db:admin:sign": "tsx scripts/admin-apply.ts sign",
    "db:admin:apply": "tsx scripts/admin-apply.ts apply",
    "db:admin:verify": "tsx scripts/admin-apply.ts verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoftwareDesignTEC/cvexpert-ms-brecha-cursos.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/SoftwareDesignTEC/cvexpert-ms-brecha-cursos/issues"
  },
  "homepage": "https://github.com/SoftwareDesignTEC/cvexpert-ms-brecha-cursos#readme",
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "swagger-ui-dist": "^5.34.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-dist": "^3.30.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
